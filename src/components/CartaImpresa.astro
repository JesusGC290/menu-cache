---
import { Image } from 'astro:assets';
// Logotipo v2 (Cache-logo-v2-tr.png), recortado de su aire transparente: 1216
// px de ancho, sin marco y con alfa. Es el mismo asset en la web y el impreso.
import logo from '../assets/cache-logo.png';
// Fotos de producto reales para la tira de la hoja 1, optimizadas desde
// material/ (originales 5000×3000 → 1600×960 JPG).
import fotoChamorro from '../assets/foto-chamorro.jpg';
import fotoNogada from '../assets/foto-chile-nogada.jpg';
import fotoParrillada from '../assets/foto-parrillada.jpg';
import fotoPostre from '../assets/foto-postre.jpg';
import CategoriaImpresa from './CategoriaImpresa.astro';
import { menus } from '../data/menu';
import '../styles/impresion.css';

interface Props {
  /** Paleta de impresión: marfil con tinta vino, u oscura como la web. */
  tema: 'claro' | 'oscuro';
  /**
   * Letrero con las medidas e instrucciones para generar el PDF. Va sólo en
   * las páginas de producción; en la muestra pública estorba.
   */
  conAviso?: boolean;
}
const { tema, conAviso = true } = Astro.props;

const fotos = [
  { src: fotoChamorro, alt: 'Chamorro al horno', pie: 'Chamorro al horno' },
  { src: fotoNogada, alt: 'Chile en nogada', pie: 'Chile en nogada' },
  { src: fotoParrillada, alt: 'Parrillada', pie: 'Parrillada' },
  { src: fotoPostre, alt: 'Postre de la casa', pie: 'Postre de la casa' },
];

const porId = (id: string) => menus.find((m) => m.id === id)!;
const desayunos = porId('desayunos');
const comidas = porId('comidas');
const bebidas = porId('bebidas');

// Cara 1: desayunos + comidas · Cara 2: portada + bebidas
const caras = [
  { id: 'frente', menus: [desayunos, comidas] },
  { id: 'vuelta', menus: [bebidas] },
];

/**
 * Reparto MANUAL de categorías por columna en la hoja 1. A diferencia del flujo
 * multicolumna de la vuelta, aquí cada categoría vive entera en una columna: no
 * se parte ni deja títulos huérfanos. Cada arreglo es una columna (izq→der).
 */
const catId = (menu: (typeof menus)[number], id: string) =>
  menu.categories.find((c) => c.id === id)!;

const columnasFrente = {
  desayunos: [
    ['pa-empezar', 'chilaquiles'],
    ['molletes', 'huevos', 'pal-capricho'],
    ['burritos', 'infantil-desayunos'],
  ],
  comidas: [
    ['pa-entrarle', 'sopas'],
    ['pa-no-rendirse', 'las-inolvidables', 'pa-los-carnivoros'],
    ['muy-nuestros', 'postres'],
  ],
};

const columnasDe = (menu: (typeof menus)[number]) =>
  (columnasFrente as Record<string, string[][]>)[menu.id].map((ids) =>
    ids.map((id) => catId(menu, id)),
  );

const totalProductos = menus.reduce(
  (n, m) => n + m.categories.reduce((k, c) => k + c.products.length, 0),
  0,
);

---

{
  conAviso && (
    <Fragment>
      <div class="aviso">
        <h1>Carta para imprenta · paleta {tema}</h1>
        <p>
          Doble carta plana, dos caras. Corte final <strong>11 × 17 in</strong> con
          <strong> 0.125 in de sangrado</strong> (archivo de 11.25 × 17.25 in) y marcas de
          corte en las esquinas. {totalProductos} productos, los mismos de la carta web.
        </p>
        <p>
          Para generar el PDF: <code>Cmd + P</code> → Destino{' '}
          <em>Guardar como PDF</em> → Márgenes <em>Ninguno</em> → y hay que activar{' '}
          <strong>Gráficos de fondo</strong>, si no el fondo y los filetes no salen.
        </p>
      </div>
    </Fragment>
  )
}

{
  caras.map((cara) => (
    /* `.encuadre` es `display: contents` por omisión, así que no altera ni el
       impreso ni la vista de producción. La muestra pública lo convierte en
       caja para poder escalar la hoja y que quepa en un celular. */
    <div class="encuadre">
    <section class={`hoja tema-${tema}`} data-cara={cara.id}>
      <div class="marcas" aria-hidden="true">
        <span class="h h1" />
        <span class="v v1" />
        <span class="h h2" />
        <span class="v v2" />
        <span class="h h3" />
        <span class="v v3" />
        <span class="h h4" />
        <span class="v v4" />
      </div>

      <div class="lienzo">
        {/* ── Cabecera ── */}
        <header class="cabecera">
          {cara.id === 'vuelta' ? (
            <Fragment>
              {/* PNG sin recomprimir y a resolución nativa: es material de imprenta.
                  `loading="eager"` es obligatorio aquí: con carga diferida el
                  navegador puede mandar la hoja a imprimir antes de bajar la
                  imagen y el logotipo saldría en blanco en el PDF. */}
              {/* Sin `widths` ni `sizes`: en una hoja impresa hay UNA resolución
                  correcta, y dejar selección responsiva sólo abre la puerta a que
                  el navegador elija una variante chica y el logotipo salga a 96 DPI.
                  Así se sirve el PNG íntegro de 1216 px → 312 DPI a 3.9 in. */}
              <Image
                src={logo}
                alt="Caché Restaurante"
                format="png"
                quality={100}
                loading="eager"
                class="placa"
              />
              <p class="marca-bajada" style="margin-top:0.12in">
                Cocina Mexicana
              </p>
              <p class="lema">«De caché, como debe ser»</p>
            </Fragment>
          ) : (
            <Fragment>
              {/* El mismo logotipo que la vuelta, más chico: esta cara carga los
                  dos menús. La bajada ya no dice «Restaurante» porque el
                  logotipo lo trae dentro. */}
              <Image
                src={logo}
                alt="Caché Restaurante"
                format="png"
                quality={100}
                loading="eager"
                class="placa placa-frente"
              />
              <p class="marca-bajada">Cocina Mexicana</p>
            </Fragment>
          )}
        </header>

        {/*
          ── Cuerpo ──

          Vuelta (bebidas): flujo multicolumna que el navegador balancea solo.

          Frente (alimentos): columnas EXPLÍCITAS. Cada categoría vive entera en
          una columna —nunca se parte ni deja un título huérfano— y el reparto
          se decide a mano en `columnasFrente`. Con la carta corta hay aire de
          sobra abajo, así que priorizamos categorías completas sobre balancear.
        */}
        {cara.id === 'frente' ? (
          <div class="cuerpo-frente">
            <div class="banda">
              <hr class="filete" />
              <h2>{desayunos.title}</h2>
              <hr class="filete" />
            </div>
            <div class="cols-3">
              {columnasDe(desayunos).map((col) => (
                <div class="col">
                  {col.map((categoria) => (
                    <CategoriaImpresa categoria={categoria} />
                  ))}
                </div>
              ))}
            </div>

            {/* Tira de fotos: parte la hoja entre Desayunos y Comidas */}
            <div class="tira-fotos">
              <hr class="filete" />
              <div class="tira-imgs">
                {fotos.map((f) => (
                  <figure class="foto">
                    {/* Marco de 2.4 in: a 1000 px son ~417 DPI, holgados frente a
                        los 300 de imprenta. Las fuentes vienen a 1600 px. */}
                    <Image src={f.src} alt={f.alt} width={1000} class="foto-img" />
                    <figcaption class="foto-pie">{f.pie}</figcaption>
                  </figure>
                ))}
              </div>
            </div>

            <div class="banda">
              <hr class="filete" />
              <h2>{comidas.title}</h2>
              <hr class="filete" />
            </div>
            <div class="cols-3">
              {columnasDe(comidas).map((col) => (
                <div class="col">
                  {col.map((categoria) => (
                    <CategoriaImpresa categoria={categoria} />
                  ))}
                </div>
              ))}
            </div>
          </div>
        ) : (
          <div class="columnas">
            {cara.menus.map((menu) => (
              <Fragment>
                <div class="banda">
                  <hr class="filete" />
                  <h2>{menu.title}</h2>
                  <hr class="filete" />
                </div>
                {menu.categories.map((categoria) => (
                  <CategoriaImpresa categoria={categoria} />
                ))}
              </Fragment>
            ))}
          </div>
        )}

        {/* ── Cierre inferior (sólo hoja 1): filete e inscripción de la casa ── */}
        {cara.id === 'frente' && (
          <div class="remate">
            <hr class="filete" />
            <p class="dicho">
              «Aquí se guisa como en casa: a fuego lento y con las recetas de las
              de antes.»
            </p>
            <p class="rubrica">De caché, como debe ser</p>
          </div>
        )}

        {/* ── Pie ── */}
        <footer class="pie">
          <hr class="filete" style="margin-bottom:0.08in" />
          <p style="margin:0">
            Precios en pesos mexicanos · IVA incluido · Sujetos a cambio sin previo aviso
          </p>
          <p style="margin:0.04in 0 0">
            <strong>Caché Restaurante</strong>
          </p>
        </footer>
      </div>
    </section>
    </div>
  ))
}
