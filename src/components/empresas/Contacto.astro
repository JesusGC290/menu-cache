---
import { contacto } from '../../data/convenio';
import { negocio } from '../../data/negocio';
import { botonLinea, ligaTexto } from './estilos';

/**
 * Dirección, horario y teléfono al cierre de /empresas y /regalos. Sale de
 * `contacto` de `convenio.ts`, que `regalos.ts` reexporta; la liga a Google
 * Maps es la misma de todo el sitio.
 */
---

<dl class="mt-10 space-y-5 text-center">
  <div>
    <dt class="text-acento text-[0.82rem]">Dirección</dt>
    <dd class="text-texto mx-auto mt-1 max-w-[30ch] text-[0.98rem] leading-relaxed font-light">
      {contacto.direccion}
    </dd>
    <dd class="mt-3">
      <a href={negocio.mapa} target="_blank" rel="noopener noreferrer" class={`${botonLinea} gap-2 px-5 py-2.5`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4" aria-hidden="true">
          <path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="12" cy="10" r="2.4" />
        </svg>
        Abrir en Google Maps
      </a>
    </dd>
  </div>

  <div>
    <dt class="text-acento text-[0.82rem]">Horario</dt>
    <dd class="text-texto mt-1 text-[0.98rem] leading-relaxed font-light">{contacto.horario}</dd>
  </div>

  <div>
    <dt class="text-acento text-[0.82rem]">Teléfono</dt>
    <dd class="mt-1">
      <a href={`tel:${contacto.telefono}`} class={`${ligaTexto} text-[0.98rem] font-light`}>
        {contacto.telefonoVisible}
      </a>
    </dd>
  </div>
</dl>
