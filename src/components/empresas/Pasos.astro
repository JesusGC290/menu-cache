---
/**
 * «Cómo funciona»: una secuencia real, numerada. El número es decorativo
 * (`aria-hidden`): el orden ya lo anuncia el `<ol>`.
 */
interface Props {
  pasos: { titulo: string; texto: string }[];
}
const { pasos } = Astro.props;
---

<ol role="list" class="mt-9">
  {
    pasos.map((paso, i) => (
      <li class="border-acento/15 grid grid-cols-[2.5rem_1fr] gap-x-4 border-t py-5 last:border-b sm:grid-cols-[3rem_1fr]">
        <span
          class="font-display text-acento text-[2.4rem] leading-[0.85] font-medium tabular-nums"
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <div>
          <h3 class="font-display text-texto text-[1.3rem] leading-snug font-medium">
            {paso.titulo}
          </h3>
          <p class="text-suave mt-1 text-[0.93rem] leading-relaxed font-light">{paso.texto}</p>
        </div>
      </li>
    ))
  }
</ol>
