---
import type { Category } from '../data/menu';

/**
 * Una categoría del pliego impreso (título, nota y productos). Se usa tanto en
 * las columnas explícitas de la hoja 1 como en el flujo multicolumna de la
 * vuelta, para no duplicar el marcado.
 */
interface Props {
  categoria: Category;
}
const { categoria } = Astro.props;

/**
 * Una categoría de puros renglones «nombre y precio» (los extras) se acomoda
 * en dos columnas: en una sola deja media columna de aire a la derecha y
 * gasta el doble de alto, que en la hoja 1 no sobra.
 */
const lista =
  categoria.products.length >= 6 &&
  categoria.products.every((p) => !p.description && !p.gramaje && !p.note);
---

<div class:list={['categoria', { lista }]}>
  <h3>{categoria.title}</h3>
  {categoria.note && (
    <p class={categoria.note.length > 46 ? 'categoria-nota larga' : 'categoria-nota'}>
      {categoria.note}
    </p>
  )}

  {categoria.products.map((p) => (
    <div class="producto">
      <div class="renglon">
        <p class="producto-nombre">{p.name}</p>
        {/* Sin precio no se dibuja la guía: unos puntos que terminan en nada
            se leen como error de impresión. */}
        {p.price && (
          <Fragment>
            <span class="guia" />
            <span class="precio">${p.price}</span>
          </Fragment>
        )}
      </div>
      {(p.gramaje || p.description) && (
        <p class="producto-desc">
          {p.gramaje && (
            <span class="gramaje">
              {p.gramaje}
              {p.description ? ' · ' : ''}
            </span>
          )}
          {p.description}
        </p>
      )}
      {p.note && <p class="producto-nota">{p.note}</p>}
    </div>
  ))}
</div>
