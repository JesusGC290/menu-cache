---
/**
 * Florón separador: filete dorado con una flor de talavera al centro.
 * Se usa arriba de cada título de categoría.
 */
interface Props {
  class?: string;
  /** Pinta los pétalos con los colores de talavera del logotipo. */
  color?: boolean;
}
const { class: className = '', color = false } = Astro.props;
---

<div class={`flex items-center justify-center gap-3 ${className}`} aria-hidden="true">
  <span class="filete-oro w-full max-w-24 opacity-70"></span>

  <svg class="h-4 w-4 shrink-0 sm:h-[1.15rem] sm:w-[1.15rem]" viewBox="0 0 24 24" fill="none">
    <g stroke="var(--color-acento)" stroke-width="1.2" stroke-linecap="round">
      <path d="M12 3.2c2.1 3.1 2.1 5.9 0 5.9s-2.1-2.8 0-5.9z" fill={color ? 'var(--color-talavera-coral)' : 'none'} fill-opacity="0.5" />
      <path d="M12 20.8c-2.1-3.1-2.1-5.9 0-5.9s2.1 2.8 0 5.9z" fill={color ? 'var(--color-talavera-turquesa)' : 'none'} fill-opacity="0.5" />
      <path d="M3.2 12c3.1-2.1 5.9-2.1 5.9 0s-2.8 2.1-5.9 0z" fill={color ? 'var(--color-talavera-verde)' : 'none'} fill-opacity="0.5" />
      <path d="M20.8 12c-3.1 2.1-5.9 2.1-5.9 0s2.8-2.1 5.9 0z" fill={color ? 'var(--color-talavera-ambar)' : 'none'} fill-opacity="0.5" />
      <circle cx="12" cy="12" r="2.1" fill="var(--color-acento)" fill-opacity="0.35" />
    </g>
  </svg>

  <span class="filete-oro w-full max-w-24 opacity-70"></span>
</div>
