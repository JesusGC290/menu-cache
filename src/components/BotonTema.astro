---
/**
 * Alterna entre tema claro y oscuro.
 *
 * Por omisión el sitio respeta la preferencia del sistema (un celular en modo
 * claro a mediodía abre en marfil). Este botón sólo sirve para forzar lo
 * contrario, y la elección se guarda en localStorage.
 *
 * Puede haber varias instancias en la página: todas leen el estado del
 * atributo `data-tema` del <html>, así que no se desincronizan.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<button
  type="button"
  class={`boton-tema border-acento/35 text-acento hover:border-acento/70 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border transition-colors duration-200 ${className}`}
  aria-label="Cambiar entre tema claro y oscuro"
  title="Cambiar tema"
>
  <!-- Sol: visible cuando está en oscuro (invita a pasar a claro) -->
  <svg
    class="icono-sol h-[1.05rem] w-[1.05rem]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
  </svg>

  <!-- Luna: visible cuando está en claro -->
  <svg
    class="icono-luna h-[1.05rem] w-[1.05rem]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5z" />
  </svg>
</button>

<style>
  /* Se muestra el icono del tema al que se va a cambiar, no el actual */
  .icono-luna {
    display: none;
  }

  :root[data-tema='claro'] .icono-sol {
    display: none;
  }
  :root[data-tema='claro'] .icono-luna {
    display: block;
  }

  /* Cuando el sistema pide claro y el usuario no forzó oscuro */
  @media (prefers-color-scheme: light) {
    :root:not([data-tema='oscuro']) .icono-sol {
      display: none;
    }
    :root:not([data-tema='oscuro']) .icono-luna {
      display: block;
    }
    /* …salvo que haya elegido claro explícitamente, que ya lo cubre la regla de arriba */
    :root[data-tema='claro'] .icono-luna {
      display: block;
    }
  }
</style>

<script>
  // Un solo listener para todas las instancias del botón
  const claroActivo = () => {
    const forzado = document.documentElement.dataset.tema;
    if (forzado) return forzado === 'claro';
    return window.matchMedia('(prefers-color-scheme: light)').matches;
  };

  document.querySelectorAll<HTMLButtonElement>('.boton-tema').forEach((boton) => {
    boton.addEventListener('click', () => {
      const nuevo = claroActivo() ? 'oscuro' : 'claro';
      document.documentElement.dataset.tema = nuevo;
      try {
        localStorage.setItem('tema', nuevo);
      } catch {
        // Modo privado o almacenamiento bloqueado: el tema dura la sesión y ya
      }
    });
  });
</script>
