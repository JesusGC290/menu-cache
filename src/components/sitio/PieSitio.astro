---
import Filigrana from '../Filigrana.astro';
import Floron from '../Floron.astro';
import { negocio } from '../../data/negocio';

const anio = new Date().getFullYear();
---

<footer class="mx-auto max-w-xl px-5 pb-14">
  <Floron class="mb-8" color />

  <div class="relative px-8 py-8 text-center">
    <Filigrana />

    <p class="font-display text-oro-degradado text-xl tracking-[0.22em] uppercase">
      Caché
    </p>
    <p class="text-humo/80 mt-1.5 text-[0.66rem] tracking-[0.24em] uppercase">
      Restaurante · Guadalajara
    </p>

    <nav class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2" aria-label="Pie">
      <a href="/carta" class="text-lino/80 hover:text-oro text-[0.74rem] tracking-[0.1em] uppercase transition-colors">
        Carta
      </a>
      <a href="#la-casa" class="text-lino/80 hover:text-oro text-[0.74rem] tracking-[0.1em] uppercase transition-colors">
        La casa
      </a>
      <a href="#visitanos" class="text-lino/80 hover:text-oro text-[0.74rem] tracking-[0.1em] uppercase transition-colors">
        Visítenos
      </a>
      <a
        href={negocio.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-lino/80 hover:text-oro text-[0.74rem] tracking-[0.1em] uppercase transition-colors"
      >
        Instagram
      </a>
    </nav>

    <p class="text-humo/60 mt-6 text-[0.64rem] tracking-[0.14em] uppercase">
      {negocio.horario.textoCorto}
    </p>
    <p class="text-humo/50 mt-1.5 text-[0.62rem]">© {anio} Caché Restaurante</p>
  </div>
</footer>
