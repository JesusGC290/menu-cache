---
import Floron from '../Floron.astro';
import { negocio } from '../../data/negocio';

// Menudo sólo en fin de semana: el dato sale de la carta, no se teclea aparte.
import { menus } from '../../data/menu';
const menudo = menus
  .flatMap((m) => m.categories)
  .find((c) => c.id === 'menudo');
---

<section id="visitanos" class="scroll-mt-20 mx-auto max-w-xl px-5 py-16 sm:py-20">
  <p class="text-acento/80 text-center text-[0.66rem] tracking-[0.34em] uppercase">
    Visítenos
  </p>

  <h2
    class="font-display text-oro-degradado mt-3 text-center text-[1.6rem] leading-tight font-medium sm:text-3xl"
  >
    Dónde y cuándo
  </h2>

  <Floron class="mt-6" />

  <dl class="mt-8 space-y-6">
    <!-- Horario -->
    <div class="border-acento/15 border-b pb-5">
      <dt class="text-acento/80 text-[0.64rem] tracking-[0.26em] uppercase">Horario</dt>
      <dd class="font-display text-texto mt-1.5 text-lg leading-snug sm:text-xl">
        {negocio.horario.texto}
      </dd>
      {
        menudo?.note && (
          <dd class="text-suave/75 mt-1 text-[0.82rem] font-light">
            Menudo: {menudo.note.toLowerCase()}.
          </dd>
        )
      }
    </div>

    <!-- Dirección -->
    <div class="border-acento/15 border-b pb-5">
      <dt class="text-acento/80 text-[0.64rem] tracking-[0.26em] uppercase">Dirección</dt>
      <dd class="text-texto mt-1.5 text-[0.95rem] leading-relaxed font-light">
        {negocio.direccion.calle}<br />
        {negocio.direccion.colonia}, {negocio.direccion.cp}<br />
        {negocio.direccion.ciudad}, {negocio.direccion.estado}
      </dd>
      <dd class="mt-3">
        <a
          href={negocio.mapa}
          target="_blank"
          rel="noopener noreferrer"
          class="border-acento/45 text-acento hover:bg-acento/10 hover:border-acento/75 inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-[0.76rem] tracking-[0.12em] uppercase transition-colors duration-200"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
            <path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="12" cy="10" r="2.4" />
          </svg>
          Abrir en Google Maps
        </a>
      </dd>
    </div>

    <!-- Contacto -->
    <div>
      <dt class="text-acento/80 text-[0.64rem] tracking-[0.26em] uppercase">
        Reservaciones y pedidos
      </dt>

      <dd class="mt-3 flex flex-wrap gap-2.5">
        <a
          href={`tel:${negocio.telefono.marcar}`}
          class="border-acento/35 text-suave hover:border-acento/70 hover:text-texto inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-[0.78rem] tracking-[0.08em] transition-colors duration-200"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
            <path
              d="M6.6 3h3l1.5 4-2 1.4a12 12 0 0 0 5.5 5.5l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.6 5.2 2 2 0 0 1 6.6 3z"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          {negocio.telefono.mostrar}
        </a>

        {
          /* El botón de WhatsApp aparece solo, sin tocar código, en cuanto se
             llene `whatsapp` en negocio.ts. Antes de eso no se dibuja: mejor
             sin botón que con un número que no contesta. */
          negocio.whatsapp && (
            <a
              href={`https://wa.me/${negocio.whatsapp.numero}?text=${encodeURIComponent(negocio.whatsapp.mensaje)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="border-acento/35 text-suave hover:border-acento/70 hover:text-texto inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-[0.78rem] tracking-[0.08em] transition-colors duration-200"
            >
              WhatsApp
            </a>
          )
        }

        <a
          href={negocio.instagram.url}
          target="_blank"
          rel="noopener noreferrer"
          class="border-acento/35 text-suave hover:border-acento/70 hover:text-texto inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-[0.78rem] tracking-[0.08em] transition-colors duration-200"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17" cy="7" r="1" fill="currentColor" stroke="none" />
          </svg>
          @{negocio.instagram.usuario}
        </a>
      </dd>
    </div>
  </dl>
</section>
