---
import Floron from '../Floron.astro';
import { menus } from '../../data/menu';

/**
 * Los platillos destacados NO se escriben a mano aquí: se leen de la carta.
 * Así un cambio de precio o de descripción en `menu.ts` se refleja también en
 * la portada, y no puede pasar que la portada anuncie algo que la carta ya no
 * dice. Si un platillo se renombra, el build truena en lugar de dejar el hueco
 * en silencio.
 */
const buscar = (nombre: string) => {
  for (const menu of menus) {
    for (const categoria of menu.categories) {
      const p = categoria.products.find((x) => x.name === nombre);
      if (p) return { ...p, categoria: categoria.title, notaCategoria: categoria.note };
    }
  }
  throw new Error(
    `Especialidades: no existe «${nombre}» en menu.ts. Si se renombró el platillo, hay que actualizar la portada.`,
  );
};

/**
 * `nota` se pone a mano y sólo donde de verdad restringe: la nota de categoría
 * («con chicharrón: más $60») aplica a todos los chilaquiles, no a uno, y en
 * una tarjeta suelta se lee como si fuera de ese platillo.
 */
const destacados = [
  { etiqueta: 'El platillo firma', producto: buscar('Huevos Caché') },
  { etiqueta: 'Lo que lleva el nombre', producto: buscar('Chilaquiles Caché') },
  { etiqueta: 'El mole de la casa', producto: buscar('Pollo en Mole') },
  { etiqueta: 'Sólo fin de semana', producto: buscar('Menudo Mediano'), nota: true },
  { etiqueta: 'Para mesa larga', producto: buscar('Parrillada') },
];
---

<section id="especialidades" class="scroll-mt-20 mx-auto max-w-xl px-5 py-16 sm:py-20">
  <p class="text-acento/80 text-center text-[0.66rem] tracking-[0.34em] uppercase">
    Lo que hay que pedir
  </p>

  <h2
    class="font-display text-oro-degradado mt-3 text-center text-[1.6rem] leading-tight font-medium sm:text-3xl"
  >
    Por dónde empezar
  </h2>

  <Floron class="mt-6" color />

  <ul class="mt-8 space-y-3.5">
    {
      destacados.map(({ etiqueta, producto, nota }) => (
        <li class="border-acento/20 bg-superficie/25 relative overflow-hidden rounded-lg border px-5 py-4">
          <p class="text-acento/85 text-[0.62rem] tracking-[0.26em] uppercase">{etiqueta}</p>

          <div class="mt-1.5 flex items-baseline gap-2">
            <h3 class="font-display text-texto text-[1.15rem] leading-snug font-medium sm:text-xl">
              {producto.name}
            </h3>
            <span class="border-acento/25 mb-1 flex-1 border-b border-dotted" />
            {producto.price && (
              <span class="text-acento text-[0.92rem] font-medium tabular-nums">
                ${producto.price}
              </span>
            )}
          </div>

          {producto.description && (
            <p class="text-suave/80 mt-1.5 text-[0.82rem] leading-relaxed font-light">
              {producto.description}
            </p>
          )}

          {nota && producto.notaCategoria && (
            <p class="text-acento/80 mt-2 text-[0.7rem] tracking-[0.14em] uppercase">
              {producto.notaCategoria}
            </p>
          )}
        </li>
      ))
    }
  </ul>

  <div class="mt-8 text-center">
    <a
      href="/carta"
      class="border-acento/45 text-acento hover:bg-acento/10 hover:border-acento/75 inline-flex items-center gap-2 rounded-full border px-6 py-3 text-[0.78rem] tracking-[0.14em] uppercase transition-colors duration-200"
    >
      Ver la carta completa
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
        <path d="M5 12h13m0 0l-5-5m5 5l-5 5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</section>
