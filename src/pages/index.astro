---
import Layout from '../layouts/Layout.astro';
import Portada from '../components/sitio/Portada.astro';
import Historia from '../components/sitio/Historia.astro';
import Especialidades from '../components/sitio/Especialidades.astro';
import Visitanos from '../components/sitio/Visitanos.astro';
import PieSitio from '../components/sitio/PieSitio.astro';
import DatosEstructurados from '../components/sitio/DatosEstructurados.astro';
---

<Layout
  title="Caché Restaurante · Cocina mexicana en Guadalajara"
  description="Cocina mexicana en Ladrón de Guevara, Guadalajara. Desayunos, comidas y bebidas todos los días de 8 am a 10 pm. Vea la carta completa."
>
  <DatosEstructurados slot="head" />

  <!-- Barra que aparece al dejar la portada: siempre a un toque de la carta -->
  <div
    id="barra"
    class="border-oro/20 bg-vino/92 pointer-events-none fixed inset-x-0 top-0 z-40 -translate-y-full border-b opacity-0 backdrop-blur-md transition-all duration-300"
  >
    <div class="mx-auto flex max-w-xl items-center justify-between gap-3 px-5 py-2.5">
      <a
        href="#"
        class="font-display text-oro-degradado text-base tracking-[0.2em] uppercase"
      >
        Caché
      </a>
      <a
        href="/carta"
        class="from-oro-claro via-oro to-oro-hondo text-vino inline-flex items-center rounded-full bg-gradient-to-b px-4 py-2 text-[0.7rem] font-medium tracking-[0.12em] uppercase"
      >
        Ver la carta
      </a>
    </div>
  </div>

  <Portada />
  <Historia />
  <Especialidades />
  <Visitanos />
  <PieSitio />
</Layout>

<style>
  #barra[data-visible='true'] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
</style>

<script>
  // La barra aparece cuando la portada sale de pantalla
  const barra = document.getElementById('barra');
  const portada = document.querySelector('header');

  if (barra && portada) {
    const observador = new IntersectionObserver(
      ([entrada]) => {
        barra.dataset.visible = String(!entrada.isIntersecting);
      },
      { rootMargin: '-70% 0px 0px 0px', threshold: 0 },
    );
    observador.observe(portada);
  }
</script>
