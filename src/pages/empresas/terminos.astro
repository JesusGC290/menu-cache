---
import Terminos from '../../layouts/Terminos.astro';
import { Content, frontmatter } from '../../data/terminos-convenio-empresas.md';
import { franjaInicio, hero, seo } from '../../data/convenio';

/**
 * Términos y condiciones del convenio — `/empresas/terminos`
 *
 * El texto vive en `terminos-convenio-empresas.md`, junto a `convenio.ts`.
 */
---

<Terminos
  titulo={frontmatter.titulo}
  descripcion={seo.descripcion}
  volver={{ texto: franjaInicio.titulo, href: franjaInicio.href }}
  boton={{ texto: hero.cta, programa: 'convenio' }}
>
  <Content />
</Terminos>
