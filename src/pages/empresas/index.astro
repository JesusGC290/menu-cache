---
import Layout from '../../layouts/Layout.astro';
import Floron from '../../components/Floron.astro';
import PieSitio from '../../components/sitio/PieSitio.astro';
import DatosEstructurados from '../../components/sitio/DatosEstructurados.astro';
import Aliados from '../../components/empresas/Aliados.astro';
import Barra from '../../components/empresas/Barra.astro';
import BotonWhatsapp from '../../components/empresas/BotonWhatsapp.astro';
import Contacto from '../../components/empresas/Contacto.astro';
import Pasos from '../../components/empresas/Pasos.astro';
import Preguntas from '../../components/empresas/Preguntas.astro';
import Titular from '../../components/empresas/Titular.astro';
import { botonLinea, ligaTexto, titulo } from '../../components/empresas/estilos';
import {
  beneficios,
  cierre,
  hero,
  intro,
  pasos,
  preguntas,
  reglas,
  seo,
  vigencia,
} from '../../data/convenio';
import { ligaDesdeEmpresas } from '../../data/regalos';

/**
 * Convenio Caché para Empresas — `cacherestaurante.com/empresas`
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Llegan dos visitantes: quien recibió el correo de Caché (recursos humanos,
 * administración, el encargado de un coworking) y el empleado que vio un
 * anuncio. Para los dos la acción es la misma, el botón de WhatsApp. No hay
 * formulario a propósito: obligaría a publicar un aviso de privacidad, y
 * Caché decidió no recabar datos por web.
 *
 * Todo el texto sale de `convenio.ts`; aquí no se teclea ni una regla. Los
 * nombres de las secciones son los del brief.
 *
 * Sigue el sistema de la carta (terciopelo y oro, dos temas, Cormorant y
 * Jost). El único gesto grande es el titular; lo demás es deliberadamente
 * sobrio: sin etiquetas en versalitas sobre los títulos, sin flechas en los
 * botones, sin tarjetas repetidas y sin animaciones de entrada.
 *
 * Analítica: ver `src/scripts/referencia.ts` (la referencia `?e=`),
 * `src/scripts/whatsapp.ts` (el clic en WhatsApp) y el script al final de
 * esta página (la visita).
 */

// La vigencia ya viene como la última regla; si algún día se quita de la
// lista, igual se muestra aparte y no se pierde la fecha.
const reglasCortas = reglas.filter((regla) => regla !== vigencia.texto);
---

<Layout title={seo.titulo} description={seo.descripcion}>
  <DatosEstructurados slot="head" />

  <!-- ═══════════ Portada ═══════════ -->
  <header class="relative">
    <Barra />

    <div class="mx-auto max-w-2xl px-5 pt-14 pb-14 text-center sm:pt-20 sm:pb-16">
      <Titular texto={hero.titulo} />

      <p
        class="text-suave mx-auto mt-6 max-w-[38ch] text-[1rem] leading-relaxed font-light sm:text-[1.08rem]"
      >
        {hero.bajada}
      </p>

      <div class="mt-9 flex flex-col items-center gap-3">
        <BotonWhatsapp texto={hero.cta} programa="convenio" ubicacion="portada" />
        <a href="/empresas/terminos" data-conserva-ref class={botonLinea}>
          {hero.secundaria}
        </a>
      </div>

      <Floron class="mt-12" color />

      <p
        class="font-display text-suave mx-auto mt-7 max-w-[36ch] text-[1.2rem] leading-snug italic sm:text-[1.35rem]"
      >
        {intro}
      </p>
    </div>
  </header>

  <main>
    <!-- ═══════════ Cómo funciona ═══════════ -->
    <section aria-labelledby="como-funciona" class="mx-auto max-w-xl px-5 py-14 sm:py-16">
      <h2 id="como-funciona" class={titulo}>Cómo funciona</h2>

      <Floron class="mt-5" />

      <Pasos pasos={pasos} />
    </section>

    <!-- ═══════════ Beneficios ═══════════ -->
    <section aria-labelledby="beneficios" class="mx-auto max-w-xl px-5 py-14 sm:py-16">
      <h2 id="beneficios" class={titulo}>Beneficios</h2>

      <Floron class="mt-5" />

      {/* Un solo marco con tres renglones, no tres tarjetas */}
      <dl class="border-acento/25 bg-superficie/25 divide-acento/15 mt-9 divide-y rounded-lg border">
        {
          beneficios.map((beneficio) => (
            <div class="px-5 py-5 sm:grid sm:grid-cols-[11rem_1fr] sm:gap-6 sm:px-6">
              <dt class="font-display text-texto text-[1.3rem] leading-snug font-medium">
                {beneficio.titulo}
              </dt>
              <dd class="text-suave mt-1 text-[0.93rem] leading-relaxed font-light sm:mt-0.5">
                {beneficio.texto}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- ═══════════ Liga a regalos ═══════════ -->
    {/* Quien registra el convenio suele ser quien también compraría regalos
        para clientes. Lleva `?e=` consigo: la visita a /regalos queda
        atribuida al mismo correo. */}
    <div class="mx-auto max-w-xl px-5">
      <div class="border-acento/20 border-y py-8 text-center">
        <p class="font-display text-texto text-[1.3rem] leading-snug italic">
          {ligaDesdeEmpresas.texto}
        </p>
        <a href={ligaDesdeEmpresas.href} data-conserva-ref class={`${botonLinea} mt-4`}>
          {ligaDesdeEmpresas.cta}
        </a>
      </div>
    </div>

    <!-- ═══════════ Empresas aliadas ═══════════ -->
    <Aliados />

    <!-- ═══════════ Lo importante ═══════════ -->
    <section aria-labelledby="lo-importante" class="mx-auto max-w-xl px-5 py-14 sm:py-16">
      <h2 id="lo-importante" class={titulo}>Lo importante</h2>

      <Floron class="mt-5" />

      <ul role="list" class="mt-9 space-y-3.5">
        {
          reglasCortas.map((regla) => (
            <li class="text-suave relative pl-6 text-[0.95rem] leading-relaxed font-light">
              <span
                class="bg-acento/80 absolute top-[0.62em] left-1 h-1.5 w-1.5 rotate-45"
                aria-hidden="true"
              />
              {regla}
            </li>
          ))
        }
      </ul>

      <p class="font-display text-texto mt-7 text-[1.2rem] leading-snug italic">
        {vigencia.texto}
      </p>

      <p class="mt-5">
        <a href="/empresas/terminos" data-conserva-ref class={`${ligaTexto} text-[0.92rem]`}>
          Términos completos
        </a>
      </p>
    </section>

    <!-- ═══════════ Preguntas frecuentes ═══════════ -->
    <section aria-labelledby="preguntas" class="mx-auto max-w-xl px-5 py-14 sm:py-16">
      <h2 id="preguntas" class={titulo}>Preguntas frecuentes</h2>

      <Floron class="mt-5" />

      <Preguntas preguntas={preguntas} />
    </section>

    <!-- ═══════════ Cierre ═══════════ -->
    <section aria-labelledby="cierre" class="mx-auto max-w-xl px-5 pt-14 pb-16 sm:pt-16">
      <h2
        id="cierre"
        class="font-display text-oro-degradado text-center text-[2rem] leading-tight font-medium text-balance sm:text-[2.5rem]"
      >
        {cierre.titulo}
      </h2>

      <Floron class="mt-5" color />

      <div class="mt-9 flex justify-center">
        <BotonWhatsapp texto={cierre.cta} programa="convenio" ubicacion="cierre" />
      </div>

      <Contacto />
    </section>
  </main>

  <PieSitio />
</Layout>

<script>
  import { analitica } from '../../scripts/analitica';
  import { refEvento } from '../../scripts/referencia';

  // Una visita por carga, con la referencia del correo o `directo`. La
  // pageview automática ya trae la URL completa; este evento deja `ref` como
  // propiedad propia para filtrar por correo sin escarbar en URLs.
  analitica().then((ph) => ph?.capture('convenio_visita', { ref: refEvento }));
</script>
