---
import Terminos from '../../layouts/Terminos.astro';
import { Content, frontmatter } from '../../data/terminos-regalos.md';
import { franjaInicio, hero, seo } from '../../data/regalos';

/**
 * Términos y condiciones de los certificados de regalo — `/regalos/terminos`
 *
 * El texto vive en `terminos-regalos.md`, junto a `regalos.ts`.
 */
---

<Terminos
  titulo={frontmatter.titulo}
  descripcion={seo.descripcion}
  volver={{ texto: franjaInicio.titulo, href: franjaInicio.href }}
  boton={{ texto: hero.cta, programa: 'regalos' }}
>
  <Content />
</Terminos>
